# ---- Persistence ----
# SQLite for local dev; point at Postgres/TimescaleDB in production.
DATABASE_URL=sqlite:///./_local/orchestrator.db

# ---- Queue (job intake — must match the worker's REDIS_URL / JOB_STREAM) ----
REDIS_URL=redis://localhost:6379/0
JOB_STREAM=scrape.jobs
CONSUMER_GROUP=workers
DEADLETTER_STREAM=scrape.jobs.deadletter

# ---- Result ingest (must match the worker's ORCHESTRATOR_TOKEN / INGEST_PATH) ----
INGEST_TOKEN=dev-token
INGEST_PATH=/api/v1/ingest/scrape-results

# ---- Scheduler ----
SCHEDULER_ENABLED=true
RECONCILE_INTERVAL_S=30

# ---- Autoscaling (off by default) ----
AUTOSCALE_ENABLED=false
AUTOSCALE_PER_REPLICA_TARGET=10
AUTOSCALE_MIN_REPLICAS=0
AUTOSCALE_MAX_REPLICAS=10

# ---- Node provisioning ----
PROVIDER=local
WORKER_IMAGE=pricescraping-worker:latest
WORKER_NETWORK=pricescraping_default
# base env handed to every worker node the orchestrator starts
WORKER_ENV_REDIS_URL=redis://redis:6379/0
WORKER_ENV_ORCHESTRATOR_BASE_URL=http://orchestrator:8000

# ---- SaladCloud (PROVIDER=salad) ----
SALAD_BASE_URL=https://api.salad.com/api/public
SALAD_API_KEY=
SALAD_ORG=
SALAD_PROJECT=
SALAD_CONTAINER_GROUP_PREFIX=pricescraping-worker

# ---- Process ----
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
